Question 8

Using customers and orders:

Find customers 
whose total spending is greater than the average total spending of all customers 
who have placed at least one order.

WITH CustomerTotals AS (
    SELECT
        c.CustomerID,
        c.Name AS CustomerName,
        SUM(o.Amount) AS TotalSpent
    FROM customers c
    JOIN orders o
        ON c.CustomerID = o.CustomerID
    GROUP BY c.CustomerID, c.Name
)
SELECT
    CustomerName,
    TotalSpent
FROM CustomerTotals
WHERE TotalSpent > (
    SELECT AVG(TotalSpent)
    FROM CustomerTotals
);
