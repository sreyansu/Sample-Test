#Given a string, remove consecutive duplicate characters.
class sample:
    def remove_con(self,s):
        res = []
        for i in range(1,len(s)):
            if s[i]==s[i-1]:
                continue
            else:
                res.append(s[i-1])
        res.append(s[-1])
        return "".join(res)

t = sample()
print(t.remove_con("aaabbcddd"))
