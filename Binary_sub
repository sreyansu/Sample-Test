def sub(a,b):
    if a>b:
        while b:
            borrow = (~a)&b
            a = a^b
            b = borrow<<1
        return a
    else:
        while a:
            borrow = (~b)&a
            b = b^a
            a = borrow<<1
        return b

n = int(input(),2)
m = int(input(),2)
print(bin(sub(n,m))[2:])
