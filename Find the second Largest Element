"""
Find the second Largest Element (Medium / Arrays)
Problem: Find the second largest element in an array without sorting it completely.
"""
def second_largest(arr):
    if len(arr) < 2:
        return -1
        
    first = second = float('-inf')
    
    for num in arr:
        if num > first:
            second = first
            first = num
        elif num > second and num != first:
            second = num
            
    return second if second != float('-inf') else -1

arr = list(map(int,input().split()))
print(second_largest(arr))
