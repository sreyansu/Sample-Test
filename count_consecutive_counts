#Given a string, print each character along with the number of times it appears consecutively.
class sample:
    def count_con(self,s):
        count=1
        for i in range(1,len(s)):
            if s[i]==s[i-1]:
                count+=1
            else:
                print(s[i-1]+str(count))
                count=1
        print(s[-1]+str(count))
        return ""

t= sample()
t.count_con("aaabbcddd")
