"""
Help of Prepsters (Set Bits Counting)
Problem Statement:
Given two integers n and k, find the count of numbers strictly less than n that have exactly k set bits (1s) in their binary representation.
"""

def count_bits_of_1(n,k):
    res = 0
    ans = []
    for i in range(1,n):
        if bin(i).count('1') == k:
            res+=1
            ans.append(i)
    return [res,ans]

n = int(input())
k = int(input())
print(count_bits_of_1(n,k))
