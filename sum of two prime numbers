#Write a program to determine if a given number can be expressed as the sum of two prime numbers. If it can, print the two prime numbers. (e.g., Input: 34 $\rightarrow$ Output: 34 can be expressed as the sum of 3 and 31).
def is_prime(n):
    if n <= 1:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def find_prime_sum(num):
    for i in range(2, (num // 2) + 1):
        if is_prime(i) and is_prime(num - i):
            return f"{num} can be expressed as the sum of {i} and {num - i}."
    return f"{num} cannot be expressed as the sum of two prime numbers."


print(find_prime_sum(34))
